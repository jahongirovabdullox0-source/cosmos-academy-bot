# ============================================
# SERVER
# ============================================
PORT=4000
NODE_ENV=development

# ============================================
# TELEGRAM BOT (@BotFather dan olinadi)
# ============================================
BOT_TOKEN=

# Webhook so'rovlarini tekshirish uchun maxfiy kalit (o'zingiz uzun tasodifiy matn yozing)
WEBHOOK_SECRET=

# Mini App va Admin Panel manzillari (lokalda standart, productionda Vercel manzillari)
WEBAPP_URL=http://localhost:5173
ADMIN_PANEL_URL=http://localhost:5174

# Render avtomatik beradi — qo'lda to'ldirish shart emas (faqat production'da mavjud bo'ladi)
RENDER_EXTERNAL_URL=

# ============================================
# DATABASE (Neon.tech PostgreSQL)
# ============================================
DATABASE_URL=
DIRECT_URL=

# ============================================
# ADMIN PANEL
# ============================================
# Kamida 10 belgi, kuchli parol (harf+raqam aralash tavsiya etiladi)
ADMIN_PASSWORD=
# Admin token imzolash uchun maxfiy kalit (uzun, tasodifiy matn)
ADMIN_SECRET=
# Internetdan (masalan ngrok/production) admin panelga kirishga ruxsat berish
ADMIN_ALLOW_REMOTE=false

# ============================================
# DEV
# ============================================
# Faqat kompyuterda ishlaydi (tunnel/production'da avtomatik o'chadi)
ALLOW_DEV_AUTH=true
